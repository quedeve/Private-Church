# Client Environment Variables (Vite prefixes with VITE_)
VITE_COLYSEUS_SERVER_URL=ws://localhost:2567
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_LIVEKIT_WS_URL=wss://your-livekit-project.livekit.cloud

# Server Environment Variables (NEVER expose to client)
PORT=2567
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Donation / Payment Gateway (Tier C - Optional)
MIDTRANS_SERVER_KEY=your-midtrans-server-key
MIDTRANS_CLIENT_KEY=your-midtrans-client-key
MIDTRANS_IS_PRODUCTION=false
